# ========================================================
# Shanmu Portfolio & Editorial Platform Environment Template
# Duplicate this file as .env.local and fill in your values
# ========================================================

# 1. Contact Form Webhook (Google Sheets / Apps Script)
VITE_SHEETS_WEBHOOK=https://script.google.com/macros/s/your_deployment_id_here/exec

# 2. Database & Authentication
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here

# 3. Media CDN & Cloud Storage
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
